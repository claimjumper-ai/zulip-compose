# Copy to .env for local use. In production these are the Portainer stack
# environment variables. Never commit .env.

# --- Host ---
ZULIP_HOST=zulip.claimjumper.ai
SETTING_ZULIP_ADMINISTRATOR=dev@claimjumper.ai
# Networks Traefik reaches the container from (X-Forwarded-For trust).
# LOADBALANCER_IPS=172.16.0.0/12

# --- Secrets: generate each with `openssl rand -hex 32` ---
ZULIP__POSTGRES_PASSWORD=change-me
ZULIP__MEMCACHED_PASSWORD=change-me
ZULIP__RABBITMQ_PASSWORD=change-me
ZULIP__REDIS_PASSWORD=change-me
ZULIP__SECRET_KEY=change-me

# --- Outgoing email (SMTP) ---
SETTING_EMAIL_HOST=smtp.example.com
SETTING_EMAIL_HOST_USER=smtp-user
ZULIP__EMAIL_PASSWORD=change-me
SETTING_EMAIL_PORT=587
SETTING_EMAIL_USE_TLS=True
SETTING_NOREPLY_EMAIL_ADDRESS=noreply@example.com
# Sender for confirmation mail; {token} is filled by Zulip. Domain must be verified at the provider.
TOKENIZED_NOREPLY_EMAIL_ADDRESS=noreply-{token}@example.com

# --- Tuning ---
# True = one process per queue worker (more RAM, more throughput).
# QUEUE_WORKERS_MULTIPROCESS=False
